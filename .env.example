# ==============================================================
#  ReceitasComIA — modelo de variáveis de ambiente
#  Copie este arquivo para ".env" e preencha os valores reais:
#     cp .env.example .env
# ==============================================================

# --- Banco de dados (PostgreSQL via Drizzle ORM) ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Inteligência Artificial (Google Gemini) ---
# Gere sua chave em: https://aistudio.google.com/app/apikey
# Deixe em branco para rodar apenas com o acervo de receitas da casa.
GEMINI_API_KEY=""
